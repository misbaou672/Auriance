# AURIANCE Configuration (.env)

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=True

# ==================== WHISPER ====================
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_DEVICE=cpu  # cpu ou cuda (GPU)

# ==================== DATABASE ====================
DATABASE_URL=sqlite:///./auriance.db
# Pour PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/auriance

# ==================== REDIS (Cache) ====================
REDIS_URL=redis://localhost:6379/0

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# ==================== AUTHENTICATION ====================
SECRET_KEY=your-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== LLM (Optional) ====================
# Pour intégration avec OpenAI ou autres
LLM_PROVIDER=openai  # openai, huggingface, local
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=sk-xxxxx

# ==================== LOGGING ====================
LOG_LEVEL=INFO
LOG_FILE=auriance_server.log

# ==================== AUDIO LIMITS ====================
MAX_AUDIO_SIZE=500  # En MB
MAX_RECORDING_DURATION=300  # En secondes
