# AURIANCE Backend Configuration
API_BASE_URL=http://localhost:8000
# Android Emulator -> http://10.0.2.2:8000
# Android device (Wi‑Fi) -> http://<YOUR_PC_LAN_IP>:8000
API_TIMEOUT_SECONDS=30
SKIP_LOGIN=false

# App Configuration
APP_NAME=AURIANCE
APP_VERSION=1.0.0
DEBUG_MODE=true

# Audio Settings
AUDIO_FORMAT=wav
SAMPLE_RATE=16000
AUDIO_QUALITY=high
